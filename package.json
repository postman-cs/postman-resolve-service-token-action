{
  "name": "@postman-cs/onboarding-resolve-service-token",
  "version": "2.1.0",
  "description": "Recommended Postman service-account token producer for GitHub Actions and CLI.",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "postman-resolve-service-token": "dist/cli.cjs"
  },
  "files": [
    "action.yml",
    "dist"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "bundle": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --define:__SEA_VERSION__=undefined --outfile=dist/index.cjs && esbuild src/cli.ts --bundle --platform=node --target=node24 --format=cjs --define:__SEA_VERSION__=undefined --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli.cjs && node -e \"if(process.platform!=='win32')require('node:fs').chmodSync('dist/cli.cjs',0o755)\"",
    "build": "npm run typecheck && npm run bundle",
    "build:sea": "bash scripts/build-sea.sh",
    "verify:bundle": "npm run bundle && node scripts/verify-dist-artifact.mjs",
    "docs:tables": "node scripts/render-action-tables.mjs --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && node --test .github/scripts/dispatch-e2e-monitor.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "github-action",
    "postman",
    "postman-api-onboarding",
    "service-account",
    "access-token"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "picomatch": ">=4.0.4",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "3.0.6",
    "brace-expansion@4": "5.0.9",
    "brace-expansion@5": "5.0.9",
    "fast-uri": ">=3.1.5",
    "nanoid@3": "3.3.18",
    "js-yaml@4": "4.3.1",
    "postcss": ">=8.5.26",
    "vite@8": "8.2.1",
    "ws": ">=8.21.3",
    "sharp": ">=0.35.0",
    "undici": "^8.10.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@postman-cs/automation-core": "^1.8.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postman-cs/postman-resolve-service-token-action"
  },
  "engines": {
    "node": ">=24"
  }
}
